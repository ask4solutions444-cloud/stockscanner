# Copy to .env for local dev (python-dotenv not wired up by default -
# just export these, or use `env $(cat .env | xargs) python app.py`)

# From https://developer.upstox.com apps dashboard
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here

# Must exactly match the Redirect URI registered on your Upstox app.
# Once deployed on Render this will be something like:
# https://your-app-name.onrender.com/callback
UPSTOX_REDIRECT_URI=https://your-app-name.onrender.com/callback

# Optional: seed today's already-generated access token so the app works
# immediately after deploy without visiting /login first. Upstox tokens
# expire daily (~3:30am IST) - after that, use /login to get a new one.
UPSTOX_ACCESS_TOKEN=your_access_token_here
